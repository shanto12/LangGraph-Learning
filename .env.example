# Copy this file to `.env` (which is git-ignored) and fill in your key,
# then load it before running:  `export $(grep -v '^#' .env | xargs)`
# -- or simply `export` the variable directly in your shell / ~/.zshrc.
#
# main.py reads ZAI_API_KEY from the environment via os.environ.

# z.ai API key for the coding plan. Get one at https://z.ai
# Format is {id}.{secret}
ZAI_API_KEY=your-zai-api-key-here
